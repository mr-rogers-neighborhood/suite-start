{
  "name": "@suite/contracts",
  "version": "0.1.0",
  "description": "The suite's shared vocabulary: app manifests, deployment capability documents, deep links and contract versions. Pure Zod and pure functions; no Electron, no React, no Loro, no I/O.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./app-manifest": {
      "types": "./dist/appManifest.d.ts",
      "development": "./src/appManifest.ts",
      "import": "./dist/appManifest.js",
      "default": "./dist/appManifest.js"
    },
    "./deployment": {
      "types": "./dist/deployment.d.ts",
      "development": "./src/deployment.ts",
      "import": "./dist/deployment.js",
      "default": "./dist/deployment.js"
    },
    "./deep-link": {
      "types": "./dist/deepLink.d.ts",
      "development": "./src/deepLink.ts",
      "import": "./dist/deepLink.js",
      "default": "./dist/deepLink.js"
    },
    "./version": {
      "types": "./dist/contractVersion.d.ts",
      "development": "./src/contractVersion.ts",
      "import": "./dist/contractVersion.js",
      "default": "./dist/contractVersion.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mr-rogers-neighborhood/suite-start.git",
    "directory": "packages/contracts"
  }
}
