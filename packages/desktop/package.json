{
  "name": "@suite/desktop",
  "version": "0.7.0",
  "description": "The Electron policy every Suite app shares: a custom protocol resolver, a strict page policy and an IPC sender check. Pure functions; no Electron import, so a test needs no window.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js",
      "default": "./dist/protocol.js"
    },
    "./csp": {
      "types": "./dist/csp.d.ts",
      "import": "./dist/csp.js",
      "default": "./dist/csp.js"
    },
    "./trust": {
      "types": "./dist/trust.d.ts",
      "import": "./dist/trust.js",
      "default": "./dist/trust.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mr-rogers-neighborhood/suite-start.git",
    "directory": "packages/desktop"
  },
  "author": {
    "name": "Suite contributors",
    "email": "maintainers@suite.run"
  },
  "license": "MIT"
}
