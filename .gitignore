node_modules/
.turbo/
coverage/
*.tsbuildinfo
.DS_Store

# A consumer installs these packages from a git URL, where pnpm refuses to run a
# git subdependency's build scripts without an allowlist keyed by the resolved
# commit. So `dist` ships. `pnpm check` rebuilds and fails if it has drifted.
!packages/*/dist/

# Playwright rewrites its own output on every run.
e2e/test-results/

# electron-builder output. The staged copies a run launches live in suite-dev/.dev.
apps/*/release/
