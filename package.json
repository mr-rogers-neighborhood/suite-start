{
  "name": "suite-start",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.13.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "check": "biome check . && pnpm build && pnpm typecheck && vitest run && node scripts/check-dist.mjs",
    "check:full": "pnpm check",
    "format": "biome format --write .",
    "lint": "biome check .",
    "publish:packages": "pnpm -r --filter './packages/*' publish --access restricted --tag next --no-git-checks",
    "test": "vitest run",
    "typecheck": "pnpm -r --workspace-concurrency=1 run typecheck",
    "verify": "pnpm check",
    "build:verify": "pnpm -r run build && git diff --exit-code -- packages",
    "e2e": "playwright test",
    "dev": "pnpm build && pnpm --filter @suite/start start",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.1",
    "husky": "^9.1.7",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
